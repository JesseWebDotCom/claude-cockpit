def newest_plugin_tool(name):
    base = os.path.expanduser("~/.claude/plugins/cache/maipai-local/cockpit")
    vs = []
    for d in glob.glob(os.path.join(base, "*")):
        v = os.path.basename(d)
        if re.match(r"^\d+(\.\d+)*$", v) and os.path.isfile(os.path.join(d, "tools", name)):
            vs.append((tuple(int(x) for x in v.split(".")), d))
    return os.path.join(sorted(vs)[-1][1], "tools", name) if vs else None


def reconcile_plan(ctx):
    """Return list of (item, new_state, note) the plan should change to match reality. Only touches
    steps this script blocked itself, or running steps whose lane is dead/finished/needs-input."""
    st, items, steps = ctx["state"], ctx["items"], ctx["step_by_id"]
    auto = st.setdefault("autoBlocked", {})
    changes = []
    for item, e in items.items():
        step = steps.get(item)
        if not step:
            continue
        ps = step.get("state")
        if ps == "running" and e["state"] in ("dead", "finished", "needs-input") and e["owner"]:
            note = {"dead": "Lane session is gone; restart it.",
                    "finished": "Report ready; waiting for the coordinator to read it.",
                    "needs-input": "Lane is waiting on a permission prompt."}[e["state"]]
            changes.append((item, "blocked", note))
        elif ps == "blocked" and item in auto and e["state"] == "working":
            changes.append((item, "running", None))
    return changes


def consume_events(ctx):
    """Apply Codex self-reports once, preserving lane credit notes and requesting a page publish."""
    root, now = ctx["root"], ctx["now"]
    event_path = os.path.join(root, "lane-health", "events.jsonl")
    try:
        with open(event_path) as f:
            lines = f.readlines()
    except OSError:
        return []
    plan_path = os.path.join(root, "plan.json")
    plan = read_json(plan_path, {}) or {}
    steps = {s["id"]: s for s in plan_steps(plan)}
    seen_path = os.path.join(root, "lane-health", "events.consumed.json")
    seen = set(read_json(seen_path, []) or [])
    applied, keep, malformed = [], [], []
    claims, locks = load_claims(root), load_locks(root)
    for raw in lines:
        try:
            ev = json.loads(raw)
            event_id = ev.get("id")
            item, lane, state = ev.get("item"), ev.get("lane"), ev.get("state")
            if event_id is None:
                event_id = hashlib.sha256(raw.encode()).hexdigest()
            if not event_id or event_id in seen:
                continue
            if not isinstance(item, str) or not isinstance(lane, str) or state not in ("done", "blocked", "idle"):
                continue
            step = steps.get(item)
            if not step or step.get("state") not in ("running", "blocked"):
                seen.add(event_id)
                continue
            if step.get("owner") and step.get("owner") != lane:
                seen.add(event_id)
                continue
            report = os.path.join(root, "codex-reports", item + ".md")
            claim = os.path.join(root, "claims", item + ".claim")
            if state == "done" and os.path.exists(claim):
                claim_m = mtime_dt(claim)
                report_m = mtime_dt(report)
                if not report_m or (claim_m and report_m <= claim_m):
                    keep.append(raw)
                    continue
            ps = os.environ.get("LH_PLAN_SET") or newest_plugin_tool("plan-set")
            if not ps:
                keep.append(raw)
                continue
            # `idle` is an observational event. A fresh report is stronger evidence and
            # is the only idle transition that changes plan state to done.
            new_state = "done" if state == "done" else "blocked" if state == "blocked" else "todo"
            note = "" if new_state == "done" else ("Codex lane reported blocked." if new_state == "blocked" else "Codex lane is idle; resume when ready.")
            cmd = [ps, "--file", plan_path, item, new_state]
            if note:
                cmd += ["--note", note]
            if new_state == "done":
                cmd += ["--say", "Codex lane reported completion"]
            rc, _ = run(cmd, timeout=20)
            if rc != 0:
                keep.append(raw)
                continue
            seen.add(event_id)
            applied.append((item, new_state, lane))
            claim_path = os.path.join(root, "claims", item + ".claim")
            try:
                os.remove(claim_path)
            except OSError:
                pass
            lock_path = os.path.join(root, "lane-locks", lane + ".lock")
            lock = locks.get(lane, {})
            if lock.get("item") == item:
                note_line = lock.get("note")
                try:
                    with open(lock_path, "w") as f:
                        f.write("coordinator: lane-health\nitem: \nacquired: \n")
                        if note_line:
                            f.write("note: " + note_line + "\n")
                except OSError:
                    pass
        except json.JSONDecodeError:
            malformed.append(raw)
            continue
        except Exception:
            continue
    write_atomic(event_path, "".join(keep))
    if malformed:
        with open(os.path.join(root, "lane-health", "events.malformed.log"), "a") as f:
            f.writelines(malformed)
    write_atomic(seen_path, json.dumps(sorted(seen)) + "\n")
    if applied:
        write_atomic(os.path.join(root, "plan-republish.request"), json.dumps({
            "requestedAt": iso(now), "reason": "; ".join("%s -> %s" % (i, s) for i, s, _ in applied),
            "source": "lane-health-events"}, indent=2) + "\n")
    return applied


def apply_changes(ctx, changes):
    root = ctx["root"]
    ps = os.environ.get("LH_PLAN_SET") or newest_plugin_tool("plan-set")
    pb = os.environ.get("LH_PLAN_PAGE_BUILD") or newest_plugin_tool("plan-page-build")
    plan_file = os.path.join(root, "plan.json")
    done = []
    auto = ctx["state"].setdefault("autoBlocked", {})
    if not ps:
        return done
    for item, state, note in changes:
        cmd = [ps, "--file", plan_file, item, state]
        if note:
            cmd += ["--note", note]
        rc, _ = run(cmd, timeout=20)
        if rc == 0:
            done.append((item, state))
            if state == "blocked":
                auto[item] = iso(ctx["now"])
            else:
                auto.pop(item, None)
    if done:
        if pb:
            run([pb, plan_file, os.path.join(root, "plan-page.html")], timeout=60)
        write_atomic(os.path.join(root, "plan-republish.request"),
                     json.dumps({"requestedAt": iso(ctx["now"]), "reason": "; ".join("%s -> %s" % d for d in done),
                                 "source": "lane-health"}, indent=2) + "\n")
    return done


def notify(msg):
    cmd = os.environ.get("LH_NOTIFY")
    if cmd:
        run(shlex.split(cmd) + [msg])
        return
    # macOS popups are off unless the switch file lane-health/notify.on exists; problems stay in health.json and the Cockpit.
    if not os.path.exists(os.path.join(os.path.dirname(os.path.abspath(__file__)), "notify.on")):
        return
    script = 'display notification %s with title "Lane health"' % json.dumps(msg)
    run(["osascript", "-e", script])


def check_unsent(ctx, act):
    """UNSENT-MESSAGE: a lane not working with typed text in its composer for UNSENT_HOLD_SEC gets a problem, and in act mode
    one Enter per UNSENT_RETRY_SEC to submit it. Always on: it only submits text already typed. Returns (problems, autoFixed)."""
    now, st = ctx["now"], ctx["state"]
    book = st.setdefault("unsent", {})
    probs, fixed = [], []
    for lane in sorted(ctx["panes"]):
        pane = ctx["panes"][lane]
        info = classify_pane(pane)
        txt = composer_text(pane)
        if not txt or info["busy"] or info["needs_input"] or info["credits"]:
            book.pop(lane, None)
            continue
        rec = book.setdefault(lane, {"since": iso(now), "fixedAt": None})
        held = (now - parse_iso(rec["since"])).total_seconds()
        if held < UNSENT_HOLD_SEC:
            continue
        probs.append({"id": "unsent-message:%s" % lane, "kind": "unsent-message",
                      "detail": "%s has text typed but not submitted for %d s: \"%s\"." % (lane, held, txt[:60])})
        last = parse_iso(rec["fixedAt"])
        if act and (last is None or (now - last).total_seconds() >= UNSENT_RETRY_SEC):
            rec["fixedAt"] = iso(now)
            if press_enter(lane):
                fixed.append({"lane": lane, "action": "pressed Enter", "text": txt[:60], "at": iso(now)})
    return probs, fixed


def handle_problems(ctx, problems, act):
    """Stamp since, notify new problems and hourly reminders, drop resolved ones from state."""
    now, st = ctx["now"], ctx["state"]
    book = st.setdefault("problems", {})
    ids = {p["id"] for p in problems}
    for pid in list(book):
        if pid not in ids:
            del book[pid]
    sent = []
    for p in problems:
        rec = book.setdefault(p["id"], {"since": iso(now), "notifiedAt": None})
        p["since"] = rec["since"]
        if p["kind"] in QUIET_KINDS or not act:
            continue
        last = parse_iso(rec["notifiedAt"])
        if p["kind"] in ONCE_KINDS and last is not None:
            continue
        if last is None or (now - last).total_seconds() >= REMIND_SEC:
            rec["notifiedAt"] = iso(now)
            sent.append(p["detail"])
    for m in sent:
        notify(m)
    return sent


# ---------- main ----------

def build_ctx(root, now, state):
    sessions = tmux_sessions()
    lanes = [s for s in sessions if s.startswith("codex")]
    return {"root": root, "now": now, "state": state, "sessions": sessions,
            "panes": {s: tmux_capture(s) for s in lanes},
            "claude_recent": parse_iso((state.get("claude") or {}).get("recentActivityAt")),
            "port_open": port_open, "pid_alive": pid_alive, "fingerprint": worktree_fingerprint,
            "repo_of": repo_of, "unpushed": unpushed_count}


def main(argv=None, ctx_hook=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    data_dir = os.environ.get("LH_DATA_DIR", root)
    act, force_claude = True, False
    while argv:
        a = argv.pop(0)
        if a == "--root":
            root = argv.pop(0)
        elif a == "--data-dir":
            data_dir = argv.pop(0)
        elif a == "--no-act":
            act = False
        elif a == "--force-claude":
            force_claude = True
        else:
            sys.stderr.write("usage: lane-health [--root DIR] [--data-dir DIR] [--no-act] [--force-claude]\n")
            return 2
    now = now_dt()
    state_dir = os.path.join(root, "lane-health")
    os.makedirs(state_dir, exist_ok=True)
    for sub in ("claims", "lane-locks", "codex-reports"):
        os.makedirs(os.path.join(root, sub), exist_ok=True)
    state_path = os.path.join(state_dir, "state.json")
    state = read_json(state_path, {}) or {}

    last_claude = parse_iso((state.get("claude") or {}).get("checkedAt"))
    if force_claude or last_claude is None or (now - last_claude).total_seconds() >= CLAUDE_INTERVAL - 10:
        scan = ctx_hook["claude_scan"](now) if ctx_hook and "claude_scan" in ctx_hook else claude_scan(now)
        state["claude"] = scan
    scan = state.get("claude") or {}

    ctx = build_ctx(root, now, state)
    if ctx_hook:
        ctx.update({k: v for k, v in ctx_hook.items() if k != "claude_scan"})
    ctx["claude_recent"] = parse_iso(scan.get("recentActivityAt"))
    consume_events(ctx) if act else None
    check_lanes(ctx)
    plan_probs, ready = plan_health(ctx, scan)
    unsent_probs, auto_fixed = check_unsent(ctx, act)
    problems = ctx["problems"] + claude_problems(scan) + plan_probs + unsent_probs

    changes = reconcile_plan(ctx) if act else []
    if changes:
        apply_changes(ctx, changes)
        for it, ns, _ in changes:
            if it in ctx["items"] and ns == "blocked":
                pass
    handle_problems(ctx, problems, act)

    # guarded auto-dispatch (LANE-HEALTH-03): off unless auto-dispatch.on exists; --no-act only reports what it would do
    on, pairs, skipped = dispatch_plan(ctx, ready)
    dispatched = []
    if act:
        for lane, item, brief in pairs:
            if do_dispatch(ctx, lane, item, brief):
                dispatched.append({"item": item, "lane": lane, "at": iso(now)})
                notify("Auto-dispatched %s to %s." % (item, lane))
    auto = {"on": on, "dispatched": dispatched, "skipped": skipped}
    if not act:
        auto["wouldDispatch"] = [{"item": i, "lane": l} for l, i, _ in pairs]

    health ={"checkedAt": iso(now), "intervalSec": INTERVAL, "claudeIntervalSec": CLAUDE_INTERVAL,
              "items": ctx["items"], "ready": ready, "readyCount": len(ready), "autoDispatch": auto, "autoFixed": auto_fixed,
              "problems": [{"id": p["id"], "kind": p["kind"], "since": p["since"], "detail": p["detail"]} for p in problems],
              "claude": {k: scan.get(k) for k in ("checkedAt", "waiting", "hung", "finishedSubagents", "live", "liveSubagents", "liveListAvailable", "cloudSessionsListable")}}
    coord = coordinator_state(now)
    if coord:
        health["coordinator"] = coord
    os.makedirs(data_dir, exist_ok=True)
    write_atomic(os.path.join(data_dir, "health.json"), json.dumps(health, indent=2) + "\n")
    state["claude"] = scan
    write_atomic(state_path, json.dumps(state, indent=1) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
