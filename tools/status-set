#!/usr/bin/env python3
"""Patch one key of the hand-written status file and stamp `updated`; every other key is left as it was.

  status-set milestone "Pairing"          a text key
  status-set done 9                       done and total take a whole number
  status-set next "item one" "item two"   next and you take one or more entries (a list)
  status-set --file /path/status.json you "answer the question"

The file is, in order: --file, the COCKPIT_STATUS_FILE variable, ./.cockpit/status.json. A missing file is created.
Keys: milestone, done, total, next, you (what the Main status card reads from the file), and the older now. Any other key is refused.
"""
import datetime
import json
import os
import sys

LISTS = {"next", "you", "now"}
NUMBERS = {"done", "total"}
TEXT = {"milestone"}


def main(argv):
    args = argv[1:]
    path = os.environ.get("COCKPIT_STATUS_FILE", "") or os.path.join(".cockpit", "status.json")
    if len(args) >= 2 and args[0] == "--file":
        path, args = args[1], args[2:]
    if not args or args[0] not in LISTS | NUMBERS | TEXT or (len(args) < 2 and args[0] not in LISTS):
        sys.stderr.write("usage: status-set [--file path] <milestone|done|total|next|you|now> [value ...]\n")
        return 2
    key, values = args[0], args[1:]
    try:
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            sys.stderr.write(path + " is not a JSON object; fix or remove it first\n")
            return 1
    except FileNotFoundError:
        data = {}
    except ValueError:
        sys.stderr.write(path + " is not valid JSON; fix or remove it first\n")
        return 1
    if key in LISTS:
        data[key] = values
    elif len(values) != 1:
        sys.stderr.write(key + " takes exactly one value\n")
        return 2
    elif key in NUMBERS:
        try:
            data[key] = int(values[0])
        except ValueError:
            sys.stderr.write(key + " needs a whole number\n")
            return 2
    else:
        data[key] = values[0]
    data["updated"] = datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
        f.write("\n")
    os.replace(tmp, path)
    return 0


sys.exit(main(sys.argv))
